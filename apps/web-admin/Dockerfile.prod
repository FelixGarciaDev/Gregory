FROM node:22-alpine AS build

WORKDIR /workspace

ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web-admin/package.json apps/web-admin/package.json

RUN pnpm install --filter web-admin... --frozen-lockfile

COPY scripts scripts
COPY apps/web-admin apps/web-admin

RUN pnpm --filter web-admin build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

COPY --from=build /workspace/apps/web-admin/.next/standalone ./
COPY --from=build /workspace/apps/web-admin/.next/static ./apps/web-admin/.next/static

WORKDIR /app/apps/web-admin

EXPOSE 3001

CMD ["node", "server.js"]
